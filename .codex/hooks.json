{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/destructive_commands.py\"",
            "timeout": 10,
            "statusMessage": "Checking for destructive data commands"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/protect_files.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected file edits"
          }
        ]
      },
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/check_changes.py\" before",
            "timeout": 20,
            "statusMessage": "Recording code before the tool runs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/check_changes.py\" after",
            "timeout": 120,
            "statusMessage": "Checking changed files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/check_changes.py\" stop",
            "timeout": 300,
            "statusMessage": "Running related tests"
          }
        ]
      }
    ]
  }
}
