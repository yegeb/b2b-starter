{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".medusa/server/**",
        ".medusa/admin/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*"],
      "outputs": ["coverage/**"]
    },
    "test:integration:http": {
      "passThroughEnv": ["DB_HOST", "DB_PORT", "DB_USERNAME", "DB_PASSWORD", "JWT_SECRET", "COOKIE_SECRET"],
      "cache": false
    },
    "test:integration:redis": {
      "passThroughEnv": ["DB_HOST", "DB_PORT", "DB_USERNAME", "DB_PASSWORD", "REDIS_URL", "JWT_SECRET", "COOKIE_SECRET"],
      "cache": false
    },
    "test:integration:modules": {
      "cache": false
    },
    "test:e2e": {
      "passThroughEnv": [
        "CI",
        "E2E_DATABASE_URL",
        "E2E_BACKEND_PORT",
        "E2E_STOREFRONT_PORT"
      ],
      "cache": false
    },
    "test:unit": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*"]
    },
    "clean": {
      "cache": false
    }
  }
}
